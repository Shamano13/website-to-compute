      text-align: center;
    }
    header h1 {
      margin: 0;
      font-size: 2.5rem;
    }
    .section {
      padding: 40px 20px;
      max-width: 1000px;
      margin: auto;
    }
    .section h2 {
      color: #004d40;
    }
    .button {
      display: inline-block;
      background-color: #00796b;
      color: white;
      padding: 15px 25px;
      text-decoration: none;
      border-radius: 6px;
      margin-top: 20px;
    }
    .form-group {
      margin-bottom: 20px;
    }
    label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
    }
    input, select, textarea {
      width: 100%;
      padding: 10px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
    ul {
      padding-left: 20px;
    }
    footer {
      background-color: #004d40;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 50px;
    }
    .notification {
      background-color: #dff0d8;
      border: 1px solid #3c763d;
      color: #3c763d;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 30px;
    }
  </style>
</head>
<body>

  <header>
    <h1>Dr.Phrama</h1>
    <p>Consultations médicales en ligne – Professionnelles & confidentielles</p>
  </header>

  <section class="section">
    <h2>Effectuer un paiement</h2>
    <p><strong>Veuillez effectuer votre paiement via l’un des moyens suivants :</strong></p>
    <ul>
      <li>Wave – +225 07 79 33 22 50</li>
      <li>PayPal – paypal.me/drpharma</li>
      <li>Carte bancaire (Visa, MasterCard)</li>
      <li>Mobile Money (MTN / Orange)</li>
    </ul>
    <p>Une fois le paiement effectué, vous recevrez une notification :</p>
    <div class="notification">
      ✅ Paiement confirmé. Vous pouvez maintenant accéder au formulaire de consultation ci-dessous.
    </div>
  </section>

  <section class="section">
    <h2>Formulaire de consultation médicale</h2>
    <form action="https://wa.me/2250779332250" method="get" target="_blank">
      <div class="form-group">
        <label for="fullname">Nom complet</label>
        <input type="text" id="fullname" name="fullname" required>
      </div>

      <div class="form-group">
        <label for="age">Âge</label>
        <input type="number" id="age" name="age" min="0" required>
      </div>

      <div class="form-group">
        <label for="gender">Sexe</label>
        <select id="gender" name="gender" required>
          <option value="">-- Sélectionner --</option>
          <option value="Homme">Homme</option>
          <option value="Femme">Femme</option>
        </select>
      </div>

      <div class="form-group">
        <label for="height">Taille (en cm, si connue)</label>
        <input type="text" id="height" name="height">
      </div>

      <div class="form-group">
        <label for="weight">Poids (en kg, si connu)</label>
        <input type="text" id="weight" name="weight">
      </div>

      <div class="form-group">
        <label for="conditions">Avez-vous l’une de ces maladies ?</label>
        <select id="conditions" name="conditions">
          <option value="">-- Sélectionner --</option>
          <option value="Diabète">Diabète</option>
          <option value="Hypertension">Hypertension</option>
          <option value="Asthme">Asthme</option>
          <option value="Aucune">Aucune</option>
        </select>
      </div>

      <div class="form-group">
        <label for="symptoms">Décrivez vos symptômes en détail</label>
        <textarea id="symptoms" name="symptoms" rows="5" required></textarea>
      </div>

      <p>✅ Lorsque vous cliquez sur ce bouton, vos réponses seront envoyées via WhatsApp au Dr.Phrama.</p>
      <button class="button" type="submit">Envoyer au Dr.Phrama via WhatsApp</button>
    </form>
  </section>

  <footer>
    <p>&copy; 2025 Dr.Phrama – Tous droits réservés | WhatsApp : +225 07 79 33 22 50</p>
  </footer>

</body>
</html>
